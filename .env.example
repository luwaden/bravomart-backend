# Copy this file to .env and fill in real values. Never commit the real .env.

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Must match the origin your Vite frontend runs on so the browser will
# accept the httpOnly refresh cookie (credentials: 'include' on the client).
CORS_ORIGIN=http://localhost:5173

# Leave blank on localhost. Set to your real domain (e.g. ".bravomart.ng")
# once you deploy behind a real domain so the refresh cookie can be shared
# across subdomains if you ever split the frontend/admin onto different ones.
COOKIE_DOMAIN=

# ── PostgreSQL (via Prisma) ─────────────────────────────────────────────
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bravomart?schema=public

# ── Redis (via ioredis) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT dual-token auth ───────────────────────────────────────────────────
# Generate strong random secrets, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-random-64-character-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-character-hex-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Must be the refresh-token lifetime expressed in seconds (30 days here) —
# this is what Redis uses as the key TTL, so keep it in sync with the line above.
REFRESH_TOKEN_TTL_SECONDS=2592000

# ── Google Gemini (@google/genai) ────────────────────────────────────────
# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ── File uploads (Multer memory storage → persisted here) ───────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
